Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force trailing slash for physical directories (e.g. /admin -> /admin/)
  # This guarantees CSS/JS asset paths resolve properly on cPanel/LiteSpeed
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 2. Serve existing physical files directly (CSS, JS, images, fonts)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Serve index.html for existing physical directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 4. Serve existing .html files directly
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 5. Fix subpath asset requests: if asset in subpath requests _next/, rewrite to root /_next/
  RewriteRule ^.*/(_next/.*)$ /$1 [L]

  # 6. Fallback for dynamic /tires/[id] routes back to tires template
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json)$ [NC]
  RewriteRule ^tires/.*$ /tires/col-1/index.html [L]

  # 7. Catch-all fallback for any other missing page route
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>
