Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve existing physical files directly (CSS, JS, images, fonts)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Serve index.html for existing physical directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 3. Serve existing .html files directly (e.g. admin.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Fallback for dynamic /tires/[id] routes (for newly added admin items in localStorage):
  # Rewrite non-existent pages/folders under /tires/ to /tires/col-1/index.html so full detail page loads with 100% CSS styles!
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json)$ [NC]
  RewriteRule ^tires/.*$ /tires/col-1/index.html [L]

  # 5. Catch-all fallback for any other missing page route
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>
